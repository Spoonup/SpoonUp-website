PORT=5001

# Staff login. Only used to bootstrap/reset the stored credential; once hashed,
# change it from Admin → Settings. Password must be at least 8 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-going-live

# Signs admin session tokens so they survive restarts and multiple instances.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Shared secret between the Cloudflare Worker and the origin. When set, the server
# rejects requests that did not come through the Worker and uses CF-Connecting-IP
# for rate limiting. Generate with: openssl rand -hex 32
ORIGIN_AUTH_SECRET=

# Set to true when running behind ngrok, a reverse proxy, or a load balancer
TRUST_PROXY=false

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty in production to allow same-origin only (recommended).
CORS_ORIGINS=

# Supabase PostgreSQL. REQUIRED in production (the server refuses to start without it).
# Use the SERVICE ROLE key on the server only.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Razorpay checkout (key id is public; secret stays on the server).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Same secret you paste in the Razorpay dashboard webhook settings.
# RAZORPAY_WEBHOOK_SECRET=your-long-random-webhook-secret

# Google Cloud Storage bucket for product images (uses Application Default Credentials).
# PRODUCT_IMAGE_BUCKET=your-bucket-name

# Drives POST /api/jobs/run-due-deliveries from Cloud Scheduler. Without it the
# endpoint is disabled (503) and recurring deliveries are never generated.
# SCHEDULER_SECRET=your-long-random-scheduler-secret
